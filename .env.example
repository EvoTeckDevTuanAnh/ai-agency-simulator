# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
AUTH_ADMIN_PASSWORD=admin

# ──────────────────────────────────────────────
# API Gateway
# ──────────────────────────────────────────────
API_GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:80,http://localhost:5173
GATEWAY_TIMEOUT_MS=5000

# ──────────────────────────────────────────────
# Services
# ──────────────────────────────────────────────
AGENT_SERVICE_PORT=3002
AUTH_SERVICE_PORT=3003
AGENT_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3003

# ──────────────────────────────────────────────
# Repository (json or notion)
# ──────────────────────────────────────────────
AGENT_REPOSITORY=json

# ──────────────────────────────────────────────
# Notion (only required when AGENT_REPOSITORY=notion)
# ──────────────────────────────────────────────
# Create a Notion integration at https://www.notion.so/profile/integrations
# Share your database with the integration email.
# Database must have these properties:
#   - id (title)
#   - sequenceNumber (number)
#   - name (rich_text)
#   - role (select: DIRECTOR, DEVELOPER, DESIGNER, CONTENT, TESTER)
#   - isDirector (checkbox)
#   - createdAt (date)
NOTION_TOKEN=
NOTION_DATABASE_ID=
